# Build-time settings for the static export (values are inlined into the HTML/JS).
# Copy to .env.local and fill in before `npm run export`.

# Google Analytics 4 measurement ID. Loaded on English pages only. Empty = disabled.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console verification token (content of the meta tag). Empty = tag omitted.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
